<UserControl x:Class="H10FirmwareManager.Pages.AnalyzePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Image to analyze" Style="{StaticResource Caption}" />
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="SourceCombo" Width="210" SelectionChanged="SourceCombo_SelectionChanged">
                            <ComboBoxItem Content="Firmware on the player" Tag="device" />
                            <ComboBoxItem Content="Bundled package image" Tag="package" />
                            <ComboBoxItem Content="Choose a file…" Tag="file" />
                        </ComboBox>
                        <TextBox x:Name="SourcePathBox" Grid.Column="1" Margin="8,0,0,0" IsReadOnly="True"
                                 FontSize="11.5" VerticalContentAlignment="Center" />
                        <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Analyze"
                                Margin="8,0,0,0" Click="Analyze_Click" />
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Style="{StaticResource SecondaryButton}" Content="Copy report" Margin="0,0,8,0"
                            Click="CopyReport_Click" />
                    <Button Style="{StaticResource SecondaryButton}" Content="Save report…" Click="SaveReport_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1.15*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,7,0">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Identity" Style="{StaticResource H3}" Margin="0,0,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="118" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="26" />
                                    <RowDefinition Height="26" />
                                    <RowDefinition Height="26" />
                                    <RowDefinition Height="26" />
                                    <RowDefinition Height="26" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="File" Style="{StaticResource KeyText}" />
                                <TextBlock x:Name="FileText" Grid.Row="0" Grid.Column="1" Text="—" Style="{StaticResource ValueText}" />
                                <TextBlock Grid.Row="1" Text="Kind" Style="{StaticResource KeyText}" />
                                <TextBlock x:Name="KindText" Grid.Row="1" Grid.Column="1" Text="—" Style="{StaticResource ValueText}" />
                                <TextBlock Grid.Row="2" Text="Size" Style="{StaticResource KeyText}" />
                                <TextBlock x:Name="SizeText" Grid.Row="2" Grid.Column="1" Text="—" Style="{StaticResource ValueText}" />
                                <TextBlock Grid.Row="3" Text="Version" Style="{StaticResource KeyText}" />
                                <TextBlock x:Name="VersionText" Grid.Row="3" Grid.Column="1" Text="—" Style="{StaticResource ValueText}" />
                                <TextBlock Grid.Row="4" Text="Status" Style="{StaticResource KeyText}" />
                                <TextBlock x:Name="StatusText" Grid.Row="4" Grid.Column="1" Text="—" Style="{StaticResource ValueText}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="mi4 header" Style="{StaticResource H3}" Margin="0,0,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="118" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="26" />
                                    <RowDefinition Height="26" />
                                    <RowDefinition Height="26" />
                                    <RowDefinition Height="26" />
                                    <RowDefinition Height="26" />
                                    <RowDefinition Height="26" />
                                    <RowDefinition Height="26" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Magic" Style="{StaticResource KeyText}" />
                                <TextBlock x:Name="MagicText" Grid.Row="0" Grid.Column="1" Text="—" Style="{StaticResource MonoText}" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="1" Text="Crypto" Style="{StaticResource KeyText}" />
                                <TextBlock x:Name="CryptoText" Grid.Row="1" Grid.Column="1" Text="—" Style="{StaticResource MonoText}" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="2" Text="TEA key" Style="{StaticResource KeyText}" />
                                <TextBlock x:Name="KeyText" Grid.Row="2" Grid.Column="1" Text="—" Style="{StaticResource MonoText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Row="3" Text="Stored CRC" Style="{StaticResource KeyText}" />
                                <TextBlock x:Name="StoredCrcText" Grid.Row="3" Grid.Column="1" Text="—" Style="{StaticResource MonoText}" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="4" Text="Computed CRC" Style="{StaticResource KeyText}" />
                                <TextBlock x:Name="ComputedCrcText" Grid.Row="4" Grid.Column="1" Text="—" Style="{StaticResource MonoText}" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="5" Text="Header / total" Style="{StaticResource KeyText}" />
                                <TextBlock x:Name="LengthsText" Grid.Row="5" Grid.Column="1" Text="—" Style="{StaticResource MonoText}" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="6" Text="Magic offset" Style="{StaticResource KeyText}" />
                                <TextBlock x:Name="MagicOffsetText" Grid.Row="6" Grid.Column="1" Text="—" Style="{StaticResource MonoText}" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="Hashes" Style="{StaticResource H3}" Margin="0,0,0,10" />
                            <TextBlock Text="SHA-256" Style="{StaticResource KeyText}" />
                            <TextBlock x:Name="Sha256Text" Text="—" Style="{StaticResource MonoText}" TextWrapping="Wrap" Margin="0,4,0,10" />
                            <TextBlock Text="MD5" Style="{StaticResource KeyText}" />
                            <TextBlock x:Name="Md5Text" Text="—" Style="{StaticResource MonoText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="1" Margin="7,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource Card}" Padding="16">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Report" Style="{StaticResource H3}" />
                            <CheckBox x:Name="StringsCheck" Grid.Column="1" Content="Include strings" IsChecked="True"
                                      VerticalAlignment="Center" Click="StringsCheck_Click" />
                        </Grid>
                        <TextBox x:Name="ReportBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                                 FontFamily="Cascadia Mono, Consolas" FontSize="11.5"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top" />
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
