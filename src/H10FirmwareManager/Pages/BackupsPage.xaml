<UserControl x:Class="H10FirmwareManager.Pages.BackupsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource PrimaryButton}" Content="Create backup" Click="CreateBackup_Click" />
                    <Button Style="{StaticResource SecondaryButton}" Content="Open folder" Margin="8,0,0,0" Click="OpenFolder_Click" />
                    <Button Style="{StaticResource SecondaryButton}" Content="Refresh" Margin="8,0,0,0" Click="Refresh_Click" />
                    <CheckBox x:Name="IncludeRockboxCheck" Content="Include .rockbox folder" Margin="16,0,0,0"
                              VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="BackupTargetText" Grid.Column="1" Text="No player selected"
                           Style="{StaticResource Muted}" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16" Visibility="Collapsed"
                x:Name="ProgressPanel">
            <StackPanel>
                <Grid>
                    <TextBlock x:Name="ProgressStageText" Text="Working…" FontWeight="SemiBold" />
                    <TextBlock x:Name="ProgressPercentText" Text="" HorizontalAlignment="Right" Style="{StaticResource Muted}" />
                </Grid>
                <ProgressBar x:Name="BackupProgressBar" Margin="0,8,0,0" Maximum="100" />
                <TextBlock x:Name="ProgressFileText" Text="" Style="{StaticResource Muted}" Margin="0,5,0,0"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.4*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,7,0">
                <ListBox x:Name="BackupsList" SelectionChanged="BackupsList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Text="{Binding CreatedText}" Style="{StaticResource Muted}" Margin="0,3,0,0" />
                                        <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                            <TextBlock Text="{Binding ContentText}" Style="{StaticResource Muted}" />
                                            <TextBlock Text=" · " Style="{StaticResource Muted}" />
                                            <TextBlock Text="{Binding DeviceLabel}" Style="{StaticResource Muted}" />
                                            <TextBlock Text=" · firmware " Style="{StaticResource Muted}" />
                                            <TextBlock Text="{Binding FirmwareVersion}" Style="{StaticResource Muted}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Reason}" Style="{StaticResource Caption}" Margin="0,5,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding SizeText}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                        <TextBlock Text="Valid" FontSize="11" FontWeight="SemiBold" Margin="0,6,0,0"
                                                   HorizontalAlignment="Right" Foreground="{StaticResource SuccessBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Valid" />
                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsValid}" Value="False">
                                                            <Setter Property="Text" Value="Invalid" />
                                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel x:Name="EmptyPanel" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="No backups yet" Style="{StaticResource H2}" HorizontalAlignment="Center" />
                    <TextBlock Text="Create one before installing firmware or replacing Rockbox."
                               Style="{StaticResource Muted}" Margin="0,6,0,0" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>

            <StackPanel Grid.Column="1" Margin="7,0,0,0">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Selected backup" Style="{StaticResource H3}" Margin="0,0,0,10" />
                        <TextBlock x:Name="SelectedNameText" Text="Select a backup" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="28" />
                                <RowDefinition Height="28" />
                                <RowDefinition Height="28" />
                                <RowDefinition Height="28" />
                                <RowDefinition Height="28" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Created" Style="{StaticResource KeyText}" />
                            <TextBlock x:Name="SelectedCreatedText" Grid.Row="0" Grid.Column="1" Style="{StaticResource ValueText}" />
                            <TextBlock Grid.Row="1" Text="Device" Style="{StaticResource KeyText}" />
                            <TextBlock x:Name="SelectedDeviceText" Grid.Row="1" Grid.Column="1" Style="{StaticResource ValueText}" />
                            <TextBlock Grid.Row="2" Text="Firmware" Style="{StaticResource KeyText}" />
                            <TextBlock x:Name="SelectedFirmwareText" Grid.Row="2" Grid.Column="1" Style="{StaticResource ValueText}" />
                            <TextBlock Grid.Row="3" Text="Contents" Style="{StaticResource KeyText}" />
                            <TextBlock x:Name="SelectedContentText" Grid.Row="3" Grid.Column="1" Style="{StaticResource ValueText}" />
                            <TextBlock Grid.Row="4" Text="Rockbox" Style="{StaticResource KeyText}" />
                            <TextBlock x:Name="SelectedRockboxText" Grid.Row="4" Grid.Column="1" Style="{StaticResource ValueText}" />
                        </Grid>
                        <Border Style="{StaticResource Inset}" Margin="0,12,0,0">
                            <TextBlock x:Name="SelectedPathText" Text="—" Style="{StaticResource MonoText}"
                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                        </Border>
                        <Button x:Name="RestoreButton" Style="{StaticResource PrimaryButton}" Content="Restore this backup"
                                Margin="0,14,0,0" IsEnabled="False" Click="Restore_Click" />
                        <Button x:Name="VerifyButton" Style="{StaticResource SecondaryButton}" Content="Verify hashes"
                                Margin="0,8,0,0" IsEnabled="False" Click="Verify_Click" />
                        <Button x:Name="DeleteButton" Style="{StaticResource DangerButton}" Content="Delete backup"
                                Margin="0,8,0,0" IsEnabled="False" Click="Delete_Click" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="Restore safety" Style="{StaticResource H3}" />
                        <TextBlock Text="Restoring overwrites files with the versions stored in the ZIP. Create a fresh backup of the current state first if you are unsure."
                                   Style="{StaticResource Muted}" Margin="0,5,0,0" TextWrapping="Wrap" />
                        <CheckBox x:Name="SafetyBackupCheck" Content="Create a backup before restoring" IsChecked="True"
                                  Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
