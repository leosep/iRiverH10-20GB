<UserControl x:Class="H10FirmwareManager.Pages.LogPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Show:" Style="{StaticResource KeyText}" Margin="0,0,8,0" />
                    <ComboBox x:Name="FilterCombo" Width="150" SelectedIndex="0" SelectionChanged="Filter_Changed">
                        <ComboBoxItem Content="All entries" Tag="all" />
                        <ComboBoxItem Content="Info and above" Tag="info" />
                        <ComboBoxItem Content="Warnings and errors" Tag="warning" />
                        <ComboBoxItem Content="Errors only" Tag="error" />
                    </ComboBox>
                    <CheckBox x:Name="AutoScrollCheck" Content="Auto-scroll" IsChecked="True" Margin="16,0,0,0"
                              VerticalAlignment="Center" />
                    <TextBlock x:Name="CountText" Text="" Style="{StaticResource Muted}" Margin="16,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource SecondaryButton}" Content="Copy" Margin="0,0,8,0"
                            Click="Copy_Click" />
                    <Button Style="{StaticResource SecondaryButton}" Content="Open log folder" Margin="0,0,8,0"
                            Click="OpenFolder_Click" />
                    <Button Style="{StaticResource GhostButton}" Content="Clear" Click="Clear_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Style="{StaticResource Card}" Grid.Row="1" Margin="0,12,0,0" Padding="8">
            <ListBox x:Name="LogList" VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="4,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="68" />
                                <ColumnDefinition Width="74" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding TimeText}" FontFamily="Cascadia Mono, Consolas" FontSize="11"
                                       Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding LevelText}" FontFamily="Cascadia Mono, Consolas"
                                       FontSize="11" FontWeight="SemiBold" Foreground="{Binding LevelBrush}" />
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding Message}" FontSize="11.5" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Detail}" FontSize="10.5" TextWrapping="Wrap"
                                           Foreground="{StaticResource MutedBrush}"
                                           Visibility="{Binding DetailVisibility}" Margin="0,1,0,0" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</UserControl>
