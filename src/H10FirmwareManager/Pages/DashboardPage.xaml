<UserControl x:Class="H10FirmwareManager.Pages.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <!-- Device selector -->
            <Border Style="{StaticResource Card}" Padding="22">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="PLAYER" Style="{StaticResource Caption}" />
                        <TextBlock Text="iRiver H10 20GB" Style="{StaticResource H2}" Margin="0,4,0,0" />
                        <TextBlock Text="Select the drive that belongs to the player. The app never touches other drives unless you explicitly choose one."
                                   Style="{StaticResource Muted}" Margin="0,6,0,12" MaxWidth="620" HorizontalAlignment="Left" />
                        <StackPanel Orientation="Horizontal">
                            <ComboBox x:Name="DeviceCombo" Width="330" SelectionChanged="DeviceCombo_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Volume.DriveLetter}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Volume.Label}" Margin="8,0,0,0" />
                                            <TextBlock Text="{Binding StatusText}" Margin="10,0,0,0"
                                                       Foreground="{StaticResource MutedBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Style="{StaticResource SecondaryButton}" Content="Rescan" Margin="10,0,0,0"
                                    Click="Rescan_Click" />
                        </StackPanel>
                    </StackPanel>
                    <Border Grid.Column="1" x:Name="HeroBadge" Style="{StaticResource Pill}" Padding="18,12"
                            VerticalAlignment="Center" Background="#102A24" BorderBrush="#1E5C4C">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="HeroDot" Width="9" Height="9" Margin="0,0,9,0"
                                         VerticalAlignment="Center" Fill="{StaticResource SuccessBrush}" />
                                <TextBlock x:Name="HeroStatusText" Text="Ready" FontWeight="SemiBold" FontSize="14" />
                            </StackPanel>
                            <TextBlock x:Name="HeroStatusDetail" Text="Firmware 1.03.01"
                                       Style="{StaticResource Muted}" Margin="18,4,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Stats -->
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Margin="0,0,7,0">
                    <StackPanel>
                        <TextBlock Text="FIRMWARE" Style="{StaticResource Caption}" />
                        <TextBlock x:Name="FirmwareVersionText" Text="1.03.01" Style="{StaticResource H1}" Margin="0,5,0,0" />
                        <TextBlock x:Name="FirmwareStateText" Text="Original iRiver firmware" Style="{StaticResource Muted}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="7,0">
                    <StackPanel>
                        <TextBlock Text="STORAGE" Style="{StaticResource Caption}" />
                        <TextBlock x:Name="StorageText" Text="—" Style="{StaticResource H1}" Margin="0,5,0,0" />
                        <ProgressBar x:Name="StorageBar" Margin="0,8,0,6" Maximum="100" />
                        <TextBlock x:Name="StorageFreeText" Text="—" Style="{StaticResource Muted}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Margin="7,0,0,0">
                    <StackPanel>
                        <TextBlock Text="HEALTH" Style="{StaticResource Caption}" />
                        <TextBlock x:Name="HealthText" Text="Healthy" Style="{StaticResource H1}" Margin="0,5,0,0" />
                        <TextBlock x:Name="HealthDetailText" Text="No problems detected" Style="{StaticResource Muted}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Main columns -->
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.25*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,7,0">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Quick actions" Style="{StaticResource H3}" />
                            <TextBlock Text="The usual path is: make a backup, then install the original firmware."
                                       Style="{StaticResource Muted}" Margin="0,4,0,14" />
                            <Button Style="{StaticResource PrimaryButton}" HorizontalContentAlignment="Left"
                                    Padding="16,12" Click="Install_Click">
                                <StackPanel>
                                    <TextBlock Text="Install original firmware" FontWeight="SemiBold" />
                                    <TextBlock Text="Writes System\H10_20GC.mi4 and the CJK font."
                                               Foreground="#DCE7FF" FontSize="11.5" Margin="0,3,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Left"
                                    Padding="16,12" Margin="0,8,0,0" Click="Backup_Click">
                                <StackPanel>
                                    <TextBlock Text="Create a full backup" FontWeight="SemiBold" />
                                    <TextBlock Text="ZIP with hashes of every system file."
                                               Style="{StaticResource Muted}" FontSize="11.5" Margin="0,3,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Left"
                                    Padding="16,12" Margin="0,8,0,0" Click="Rockbox_Click">
                                <StackPanel>
                                    <TextBlock Text="Replace Rockbox" FontWeight="SemiBold" />
                                    <TextBlock Text="Restore the original boot path and optionally remove Rockbox data."
                                               Style="{StaticResource Muted}" FontSize="11.5" Margin="0,3,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Left"
                                    Padding="16,12" Margin="0,8,0,0" Click="Repair_Click">
                                <StackPanel>
                                    <TextBlock Text="Repair or format" FontWeight="SemiBold" />
                                    <TextBlock Text="Fix a fresh or damaged drive; format as FAT32 with 16 KB clusters."
                                               Style="{StaticResource Muted}" FontSize="11.5" Margin="0,3,0,0" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="What is on the player" Style="{StaticResource H3}" />
                            <TextBlock Text="The H10 bootloader only needs the firmware image; the font is part of a complete system."
                                       Style="{StaticResource Muted}" Margin="0,4,0,12" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="System\H10_20GC.mi4" Style="{StaticResource MonoText}" Margin="0,5" />
                                <TextBlock x:Name="FirmwareFileStatus" Grid.Row="0" Grid.Column="1" Text="—" FontSize="11.5" Margin="10,5,0,5" />
                                <TextBlock Grid.Row="1" Text="System\Font\cjk12.fnt" Style="{StaticResource MonoText}" Margin="0,5" />
                                <TextBlock x:Name="FontFileStatus" Grid.Row="1" Grid.Column="1" Text="—" FontSize="11.5" Margin="10,5,0,5" />
                                <TextBlock Grid.Row="2" Text="System\OF.mi4" Style="{StaticResource MonoText}" Margin="0,5" />
                                <TextBlock x:Name="OfFileStatus" Grid.Row="2" Grid.Column="1" Text="—" FontSize="11.5" Margin="10,5,0,5" />
                                <TextBlock Grid.Row="3" Text=".rockbox\" Style="{StaticResource MonoText}" Margin="0,5" />
                                <TextBlock x:Name="RockboxFolderStatus" Grid.Row="3" Grid.Column="1" Text="—" FontSize="11.5" Margin="10,5,0,5" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="7,0,0,0">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Device details" Style="{StaticResource H3}" Margin="0,0,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="28" />
                                    <RowDefinition Height="28" />
                                    <RowDefinition Height="28" />
                                    <RowDefinition Height="28" />
                                    <RowDefinition Height="28" />
                                    <RowDefinition Height="28" />
                                    <RowDefinition Height="28" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Drive" Style="{StaticResource KeyText}" />
                                <TextBlock x:Name="DetailDrive" Grid.Row="0" Grid.Column="1" Text="—" Style="{StaticResource ValueText}" />
                                <TextBlock Grid.Row="1" Text="Label" Style="{StaticResource KeyText}" />
                                <TextBlock x:Name="DetailLabel" Grid.Row="1" Grid.Column="1" Text="—" Style="{StaticResource ValueText}" />
                                <TextBlock Grid.Row="2" Text="File system" Style="{StaticResource KeyText}" />
                                <TextBlock x:Name="DetailFileSystem" Grid.Row="2" Grid.Column="1" Text="—" Style="{StaticResource ValueText}" />
                                <TextBlock Grid.Row="3" Text="Capacity" Style="{StaticResource KeyText}" />
                                <TextBlock x:Name="DetailCapacity" Grid.Row="3" Grid.Column="1" Text="—" Style="{StaticResource ValueText}" />
                                <TextBlock Grid.Row="4" Text="Cluster" Style="{StaticResource KeyText}" />
                                <TextBlock x:Name="DetailCluster" Grid.Row="4" Grid.Column="1" Text="—" Style="{StaticResource ValueText}" />
                                <TextBlock Grid.Row="5" Text="USB device" Style="{StaticResource KeyText}" />
                                <TextBlock x:Name="DetailUsb" Grid.Row="5" Grid.Column="1" Text="—" Style="{StaticResource ValueText}" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="6" Text="Serial" Style="{StaticResource KeyText}" />
                                <TextBlock x:Name="DetailSerial" Grid.Row="6" Grid.Column="1" Text="—" Style="{StaticResource ValueText}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="Notices" Style="{StaticResource H3}" Margin="0,0,0,8" />
                            <ItemsControl x:Name="NoticesList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Inset}" Margin="0,0,0,8">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center"
                                                             Fill="{Binding Brush}" />
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}"
                                                           Margin="15,4,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="NoNoticesText" Text="Everything looks good." Style="{StaticResource Muted}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
