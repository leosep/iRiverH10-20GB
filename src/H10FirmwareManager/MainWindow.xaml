<Window x:Class="H10FirmwareManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="H10 Firmware Manager"
        Width="1180" Height="720"
        MinWidth="900" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        TextOptions.TextFormattingMode="Display"
        Icon="Assets/app.ico">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="0,18,0,14">
                <StackPanel DockPanel.Dock="Top" Margin="20,0,20,18">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="42" Height="42" CornerRadius="12">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#4F8CFF" Offset="0" />
                                    <GradientStop Color="#2E5FCC" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="H10" FontSize="15" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Firmware Manager" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="iRiver H10 20GB" Style="{StaticResource Muted}" FontSize="11" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="16,8,16,0">
                    <Border Style="{StaticResource Card}" Padding="12" Cursor="Hand"
                            MouseLeftButtonUp="DeviceCard_Click">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="SideDot" Width="8" Height="8" Margin="0,0,9,0"
                                         VerticalAlignment="Center" Fill="{StaticResource MutedBrush}" />
                                <TextBlock x:Name="SideDeviceText" Text="Scanning…" FontWeight="SemiBold"
                                           FontSize="12.5" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock x:Name="SideStatusText" Text="Looking for the player"
                                       Style="{StaticResource Muted}" Margin="17,4,0,0" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="SideFirmwareText" Text="" Style="{StaticResource Caption}"
                                       Margin="17,6,0,0" />
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="VersionText" Text="v1.0.0" Style="{StaticResource Caption}"
                               Margin="4,10,0,0" />
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="PLAYER" Style="{StaticResource Caption}" Margin="26,2,0,6" />
                        <RadioButton x:Name="NavDashboard" Style="{StaticResource NavButton}" Tag="dashboard"
                                     IsChecked="True" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE80F;" FontFamily="{StaticResource IconFont}" FontSize="15" Width="22" />
                                <TextBlock Text="Dashboard" Margin="8,0,0,0" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavButton}" Tag="install" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="15" Width="22" />
                                <TextBlock Text="Install firmware" Margin="8,0,0,0" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavButton}" Tag="backups" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74E;" FontFamily="{StaticResource IconFont}" FontSize="15" Width="22" />
                                <TextBlock Text="Backups" Margin="8,0,0,0" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavButton}" Tag="rockbox" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8AC;" FontFamily="{StaticResource IconFont}" FontSize="15" Width="22" />
                                <TextBlock Text="Rockbox" Margin="8,0,0,0" />
                            </StackPanel>
                        </RadioButton>

                        <Border Height="1" Background="{StaticResource BorderSoftBrush}" Margin="22,12" />
                        <TextBlock Text="TOOLS" Style="{StaticResource Caption}" Margin="26,2,0,6" />
                        <RadioButton Style="{StaticResource NavButton}" Tag="analyze" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource IconFont}" FontSize="15" Width="22" />
                                <TextBlock Text="Firmware analysis" Margin="8,0,0,0" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavButton}" Tag="repair" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE90F;" FontFamily="{StaticResource IconFont}" FontSize="15" Width="22" />
                                <TextBlock Text="Repair &amp; format" Margin="8,0,0,0" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavButton}" Tag="log" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE81C;" FontFamily="{StaticResource IconFont}" FontSize="15" Width="22" />
                                <TextBlock Text="Activity log" Margin="8,0,0,0" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavButton}" Tag="settings" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="15" Width="22" />
                                <TextBlock Text="Settings &amp; about" Margin="8,0,0,0" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Main area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="28,22,28,16"
                    BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitle" Text="Dashboard" Style="{StaticResource H1}" />
                        <TextBlock x:Name="PageSubtitle" Text="Player status, firmware and quick actions."
                                   Style="{StaticResource Muted}" Margin="0,5,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border Style="{StaticResource Pill}" Margin="0,0,10,0" Padding="12,7">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="HeaderDot" Width="8" Height="8" Margin="0,0,9,0"
                                         VerticalAlignment="Center" Fill="{StaticResource MutedBrush}" />
                                <TextBlock x:Name="HeaderDeviceText" Text="No player detected"
                                           FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Button x:Name="RefreshButton" Style="{StaticResource IconButton}" Content="&#xE72C;"
                                ToolTip="Rescan devices and refresh this page" Click="Refresh_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <ContentControl x:Name="PageHost" Grid.Row="1" Margin="28,20,28,24" />
        </Grid>
    </Grid>
</Window>
